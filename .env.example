# Supabase + Cloudflare Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to Git!

# ─── Supabase ────────────────────────────────────────────────
# From: Supabase Dashboard > Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── App Config ───────────────────────────────────────────────
VITE_APP_NAME=Paint Tinting Manager
VITE_APP_VERSION=2.0.0

# ─── Keycloak through Supabase OAuth ─────────────────────────
# First configure the Keycloak provider in Supabase Dashboard > Authentication.
# This flag only shows the Keycloak login button; never store Keycloak secrets here.
VITE_ENABLE_KEYCLOAK=false
VITE_KEYCLOAK_ACCOUNT_URL=https://auth.nasun.vn/realms/nasun/account

# ─── Development ──────────────────────────────────────────────
# Set to "true" to show dev-mode role selector in header
VITE_DEV_MODE=true
