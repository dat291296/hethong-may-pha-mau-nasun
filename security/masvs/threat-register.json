    { "id": "TM-003", "category": "Information Disclosure", "asset": "Business and location data", "scenario": "Sensitive records leak through device storage, logs, clipboard, cache, or exported files.", "severity": "high", "status": "open", "controls": ["Encrypted offline cache", "security headers"], "nextModule": "MASVS-2" },
    { "id": "TM-004", "category": "Elevation of Privilege", "asset": "Administrative operations", "scenario": "A modified client attempts an administrator or cross-region operation.", "severity": "critical", "status": "mitigated", "controls": ["Supabase RLS", "database RPC authorization", "role checks", "audit events"], "nextModule": "MASVS-9" },
    { "id": "TM-005", "category": "Denial of Service", "asset": "Synchronization availability", "scenario": "Malformed imports or a retry storm blocks the UI and sync queue.", "severity": "medium", "status": "partially-mitigated", "controls": ["Import limits", "queue backoff", "request timeout"], "nextModule": "MASVS-6" },
