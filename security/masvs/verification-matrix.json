  "realIosAcceptance": {
    "state": "awaiting-device-test",
    "requiredMetadata": [
      "device model",
      "iOS version",
      "Safari version",
      "staging URL",
      "tested commit",
      "timestamp"
    ],
    "checks": [
      "HTTPS preview targets only approved staging",
      "Login using a dedicated staging account",
      "Offline draft survives closing and reopening Safari",
      "Reconnect after server revocation signs out and preserves pending changes",
