  "cards": [
    {
      "dot": "cyan",
      "title": "Kien Truc Da Nen Tang (Multi-Platform)",
      "items": [
        "Ho tro Web PWA tren mobile, trinh duyet PC va Electron Desktop Agent",
        "Dong goi toi uu qua Vite, phan phoi CDN toan cau qua Cloudflare Pages Edge",
        "Desktop Agent chi dung anon JWT, KHONG bao gio giu service key"
      ]
    },
    {
      "dot": "emerald",
      "title": "Dong Bo 3 Tang + Conflict Resolution",
      "items": [
        "Tang 1: LocalStorage luu session dang nhap va bo dem audit logs tuc thi",
        "Tang 2: IndexedDB duy tri co so du lieu offline + ETag cache cho conflict detection",
        "Tang 3: Sync Worker (Service Worker) xu ly Background Sync API, retry exponential backoff",
        "Conflict Resolver: 3-way merge tu dong, fallback manual UI khi can thiet",
        "Supabase Cloud PostgreSQL nhan patch cuoi cung qua Edge Functions proxy"
      ]
    },
    {
      "dot": "violet",
      "title": "Nghiep Vu Ky Thuat Chuyen Sau",
      "items": [
        "Tu dong truy xuat thiet bi, so seri va ho tro doi may moi/cu tuc thi",
        "TSP Worker: giai thuat 2-opt chay tren Web Worker rieng, khong block UI thread",
        "Lap ke hoach bao tri 1 nam va toi uu lo trinh di chuyen qua TSP Web Worker",
        "Ban do ky thuat thuc dia ket hop OpenStreetMap, CartoDB va Google Maps"
      ]
    },
    {
      "dot": "rose",
      "title": "Bao Mat Theo Chieu Sau (Defense-in-Depth)",
      "items": [
        "Client chi giu anon key (Supabase public key) - service key bi cam tren browser/Electron",
        "Moi mutation di qua Edge Functions (Deno): RBAC check, rate limiting, input validation",
        "Row Level Security (RLS) tren PostgreSQL la lop bao ve cuoi, khong the bypass",
        "Audit log ghi tren ca client (LocalStorage) va server (PostgreSQL) de doi chieu"
      ]
    }
  ]
}