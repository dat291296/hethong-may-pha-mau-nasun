{
  "schemaVersion": 4,
  "status": "current",
  "updatedForModule": "ENT-4",
  "clients": ["mobile-pwa", "desktop-web"],
  "delivery": { "provider": "cloudflare-workers-static-assets", "transport": "https" },
  "application": {
    "runtime": "react-vite-pwa",
    "authentication": "supabase-auth-pkce",
    "authorization": ["five-role-rbac", "regional-rls"],
    "roles": ["admin", "manager", "technician", "qc", "viewer"]
  },
  "offline": {
    "storage": "owner-scoped-encrypted-indexeddb",
    "queue": "idempotent-versioned-mutations",
    "reconciliation": "durable-change-feed",
    "realtime": "metadata-only-accelerator"
  },
  "data": {
    "provider": "supabase-postgresql",
    "browserCredential": "anon-key-with-user-jwt",
    "controls": ["row-level-security", "rpc-validation", "rate-limits", "audit-log"]
  },
  "boundaries": {
    "directMachineControl": false,
    "serviceRoleInClient": false,
    "retiredObjects": ["formula_versions", "agent_telemetry", "diagnostic_commands"]
  }
}
