  "cards": [
    {
      "dot": "cyan",
      "title": "Kien Truc Da Nen Tang (Multi-Platform)",
      "items": [
        "Ho tro Web PWA tren mobile, trinh duyet PC va Electron Desktop Agent",
        "Dong goi toi uu qua Vite, phan phoi CDN toan cau qua Cloudflare Pages Edge",
        "Desktop Agent chi dung anon JWT, khong giu service key"
      ]
    },
    {
      "dot": "emerald",
      "title": "Dong Bo 3 Tang + Conflict Resolution",
      "items": [
        "Tang 1: LocalStorage - session dang nhap va bo dem audit logs tuc thi",
        "Tang 2: IndexedDB - co so du lieu offline + ETag cache cho conflict detection",
        "Tang 3: Sync Worker (Service Worker) - Background Sync API, retry exponential backoff",
        "Conflict Resolver: 3-way merge tu dong, fallback manual UI khi field bi xung dot",
        "Commit cuoi cung qua Edge Functions proxy, RLS la lop bao ve cuoi"
      ]
    },
    {
      "dot": "violet",
      "title": "Nghiep Vu Ky Thuat Chuyen Sau",
      "items": [
        "Tu dong truy xuat thiet bi, so seri va ho tro doi may moi/cu tuc thi",
        "TSP Worker: giai thuat 2-opt chay tren Web Worker rieng, khong block UI thread",
        "Lap ke hoach bao tri 1 nam va toi uu lo trinh di chuyen qua TSP Web Worker",
        "Ban do ky thuat thuc dia ket hop OpenStreetMap, CartoDB va Google Maps"
      ]
    },
    {
      "dot": "amber",
      "title": "Realtime va Bao Cao Admin",
      "items": [
        "Supabase Realtime subscribe theo npp_id (khong subscribe toan bang, tranh throttle)",
        "WebSocket push trang thai may toi ky thuat vien dang online tuc thi",
        "Report Module chi mo cho role admin, query qua PostgreSQL materialized view",
        "Bao cao cap phat / bao tri / sua chua theo thang, quy, nam"
      ]
    },
    {
      "dot": "rose",
      "title": "Bao Mat Theo Chieu Sau (Defense-in-Depth)",
      "items": [
        "Client chi giu anon key - service key bi giam can trong Edge Functions (Deno)",
        "Moi mutation di qua Edge Functions: RBAC check, rate limiting, input validation",
        "Row Level Security (RLS) tren PostgreSQL la lop bao ve cuoi, khong the bypass",
        "Audit log ghi tren ca client (LocalStorage) va server (PostgreSQL) de doi chieu"
      ]
    }
  ]
}